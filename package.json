{
  "name": "dbt-perspective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native TypeScript renderer for dbt Charts YAML using Perspective.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx src/board.test.ts && node --import tsx src/observability/observability.test.ts && node --import tsx src/observability/yaml-board.test.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "schema:generate": "node scripts/generate-schema.mjs",
    "check": "npm test && npm run build && npm run test:e2e",
    "assets:verify": "node scripts/verify-duckdb-assets.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@finos/perspective": "3.8.0",
    "@finos/perspective-viewer": "3.8.0",
    "@finos/perspective-viewer-d3fc": "3.8.0",
    "@finos/perspective-viewer-datagrid": "3.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
